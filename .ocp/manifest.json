  "purpose": "Make implementation and runtime verification reproducible by an independent actor without GitHub or builder-session access.",
  "contract": ".ocp/verification-contract.json",
  "current_state": ".ocp/current-state.json",
  "capability_registry": ".ocp/capability-registry.json",
  "runtime_targets": ".ocp/runtime/targets.json",
  "evidence_root": ".ocp/evidence/runs",
  "human_documentation": "docs/OCP-HARNESS-BASELINE-V1.md",
  "commands": {
    "verify": "npm run verify",
    "build": "npm run build",
    "start": "npm run start:runtime",
    "healthcheck": "npm run runtime:healthcheck",
    "test": "npm test",
    "browser_test": "npm run test:runtime:external"
  },
  "state_ladder": [
    "DECLARED",
    "IMPLEMENTED",
    "BUILD_VERIFIED",
    "DEPLOYABLE",
    "DEPLOYED",
    "ACCESSIBLE",
    "INTERACTABLE",
    "RUNTIME_VERIFIED",
    "ACCEPTANCE_VERIFIED",
    "OUTCOME_OBSERVED"
